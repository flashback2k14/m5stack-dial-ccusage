# dial-usage-proxy -- Konfiguration
# ---------------------------------------------------------------------------
# Diese Datei nach ".env" kopieren und anpassen:  cp .env.example .env
# Die .env enthaelt ggf. interne IPs -- nicht ins Repo committen (.gitignore).

# --- HTTP-Server -----------------------------------------------------------
PORT=8088
# Min. Abstand zwischen zwei ccusage-Aufrufen (Cache), in Millisekunden.
CACHE_TTL_MS=60000

# --- Token-Budgets (Richtwerte, nach Erfahrung kalibrieren) ----------------
# Anthropic nennt keine harte Tokenzahl pro Fenster -- siehe README.
BLOCK_TOKEN_BUDGET=12000000
WEEK_TOKEN_BUDGET=70000000

# Timezone, in der ccusage die Tage gruppiert.
CC_TIMEZONE=Europe/Berlin

# --- SSH-Verbindung zum Mac (dort laeuft ccusage) --------------------------
SSH_HOST=192.168.1.20
SSH_USER=sebastian
SSH_PORT=22
SSH_KEY=/keys/id_dial
# PATH auf dem Mac. Apple Silicon: /opt/homebrew/bin, Intel: /usr/local/bin.
REMOTE_PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
